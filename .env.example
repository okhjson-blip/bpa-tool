# Supabase Project Settings > Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only secret. Never prefix with VITE_ and never expose in index.html.
# 새 프로젝트는 SUPABASE_SECRET_KEY를 우선 사용합니다. 레거시 프로젝트는
# 같은 값의 별칭인 SUPABASE_SERVICE_ROLE_KEY를 대신 사용할 수 있습니다(둘 중 하나만 필수).
SUPABASE_SECRET_KEY=your-supabase-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# CLI에서 직접 SQL 연결이 필요한 경우에만 사용합니다. db.<ref>.supabase.co 대신
# Supabase Dashboard의 Transaction pooler(:6543, user postgres.<PROJECT_REF>) URL을 사용하세요.
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# BPA_ADMIN_PASSWORD는 이 파일이나 Vercel에 저장하지 않고 Supabase Edge Function Secret으로 관리합니다.

# 32자 이상의 랜덤 비밀값. 협력사 AI API Key의 AES-256-GCM 암호화에 사용합니다.
# 운영 중 값을 바꾸면 기존 Key를 복호화할 수 없으므로 안전한 비밀 저장소에서 관리하세요.
BPA_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Vite 브라우저용 공개 Supabase Auth 설정
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Local Express server
PORT=5000

# Gemini stable model used by connection checks and AI analysis
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI model used by connection checks and AI analysis
OPENAI_MODEL=gpt-5-nano
