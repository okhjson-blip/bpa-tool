# Supabase Project Settings > Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only secret. Never prefix with VITE_ and never expose in index.html.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key

# Local Express server
PORT=5000

# Gemini stable model used by connection checks and AI analysis
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI model used by connection checks and AI analysis
OPENAI_MODEL=gpt-5-nano
